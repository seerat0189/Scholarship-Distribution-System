// This is your Prisma schema file
// Learn more at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum to represent scholarship lifecycle states
enum ScholarshipStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  role           Role            @default(USER)
  age            Int?
  gender         String?
  cgpa           Float?
  college        String?
  degree         String?
  profiles       Profile[]
  applications   Application[]
  createdAt      DateTime        @default(now())

// 🧩 Relation: All chats involving this user
  chatMessages   ChatMessage[]
}

model Organization {
  id               Int             @id @default(autoincrement())
  name             String
  email            String          @unique
  password         String
  website          String?
  scholarships     Scholarship[]
  createdAt        DateTime        @default(now())

  // 🧩 Relation: All chats involving this organization
  chatMessages     ChatMessage[]
  }

model Scholarship {
  id              Int             @id @default(autoincrement())
  scholarshipName String
  eligibility     String?
  amount          Float
  minimumCgpa     Float?
  organizationId  Int
  organization    Organization    @relation(fields: [organizationId], references: [id])
  applications    Application[]
  createdAt       DateTime        @default(now())
  // Use enum for stricter status values: UPCOMING, ACTIVE, CLOSED
  status          ScholarshipStatus  @default(UPCOMING)
  // --- Coding Test fields ---
  testMode        Boolean  @default(false)
  testQuestionId  String?
}

model Application {
  id             Int          @id @default(autoincrement())
  userId         Int
  scholarshipId  Int
  user           User         @relation(fields: [userId], references: [id])
  scholarship    Scholarship  @relation(fields: [scholarshipId], references: [id])
  status         String       @default("Pending")
  createdAt      DateTime     @default(now())

  testScore      Int?
  totalScore     Int?
}

model Profile {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  name      String
  email     String
  cgpa      Float?
  college   String?
  degree    String?
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  type      String   @default("INFO") // e.g., INFO, ALERT, SUCCESS
  createdAt DateTime @default(now())
}

model ChatMessage {
  id             Int           @id @default(autoincrement())
  message        String
  createdAt      DateTime      @default(now())

  // Participants
  userId         Int
  organizationId Int
  
  // Who sent this specific message? (USER or ORGANIZATION)
  sender         Role          

  // 🔗 Relations
  user           User          @relation(fields: [userId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])
}

enum Role {
  USER
  ORGANIZATION
  ADMIN
}
