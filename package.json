{
  "name": "scholarship-distribution-system",
  "version": "1.0.0",
  "description": "Scholarship Distribution System - Full Stack Application",
  "scripts": {
    "setup": "npm run setup:frontend && npm run setup:backend",
    "setup:frontend": "cd frontend && npm install",
    "setup:backend": "cd backend && npm run setup",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "prisma:migrate": "cd backend && npm run prisma:migrate",
    "prisma:push": "cd backend && npm run prisma:push",
    "prisma:studio": "cd backend && npm run prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
